# ---------------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------------
# Project URL — found in Supabase dashboard: Settings > API > Project URL
SUPABASE_URL=

# Anon (public) key — safe to expose to browser when RLS policies are set
# Found in Supabase dashboard: Settings > API > Project API keys > anon
SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------
# Cloudflare Web Analytics
# ---------------------------------------------------------------------
# Token from Cloudflare dashboard: Analytics & Logs > Web Analytics
# Leave empty in dev to disable analytics locally
PUBLIC_CF_ANALYTICS_TOKEN=
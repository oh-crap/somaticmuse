---
import BackgroundVideo from "../components/BackgroundVideo.astro";
import "../styles/global.css";
import Navigation from "../components/Navigation.astro";
import Footer from "../components/Footer.astro";


interface Props {
  title: string;
  description?: string;
  lang?: "ro" | "en";
}

const { title, description, lang = "ro" } = Astro.props;
const cfToken = import.meta.env.PUBLIC_CF_ANALYTICS_TOKEN;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/png" href="https://media.somaticmusehealing.com/images/somatic-muse-logo.png" />
    <link rel="apple-touch-icon" href="https://media.somaticmusehealing.com/images/somatic-muse-logo.png" />

    <title>{title}</title>
    {description && <meta name="description" content={description} />}

    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={lang === "ro" ? "ro_RO" : "en_US"} />
    <meta property="og:url" content={Astro.url.href} />
    {cfToken && (
      <script
        is:inline
        defer
        src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon={JSON.stringify({ token: cfToken })}
      />
    )}
  </head>
  <body class="min-h-dvh flex flex-col">
    <BackgroundVideo />
    <Navigation lang={lang} />
        <main class="flex-1">
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
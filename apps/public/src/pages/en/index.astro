---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Hero from "../../components/Hero.astro";
import About from "../../components/About.astro";
import Services from "../../components/Services.astro";
import Schedule from "../../components/Schedule.astro";
import Testimonials from "../../components/Testimonials.astro";
import Contact from "../../components/Contact.astro";
import { supabase } from "../../lib/supabase";
import type { Course } from "@somaticmuse/shared";

// Fetch upcoming courses for JSON-LD structured data in BaseLayout.
// Note: the <Schedule> component does its own fetch; this is a small
// duplicate DB call. Acceptable for now; could be hoisted later.
const { data: coursesData } = await supabase
  .from("courses")
  .select("*")
  .gt("start_at", new Date().toISOString())
  .order("start_at");

const courses: Course[] = (coursesData ?? []) as Course[];
---
<BaseLayout
  title="Somatic Muse Healing — Yoga and Somatic Practice in Bucharest"
  description="Yoga and somatic healing in Bucharest. Body-aware movement, breathwork, and conscious presence. Private and group sessions."
  lang="en"
  courses={courses}
>
  <Hero lang="en" />
  <About lang="en" />
  <Services lang="en" />
  <Schedule lang="en" />
  <Testimonials lang="en" />
  <Contact lang="en" />
</BaseLayout>
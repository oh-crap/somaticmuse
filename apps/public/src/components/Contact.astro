---
// apps/public/src/components/Contact.astro
// Contact section — WhatsApp + email primary CTAs + Instagram + LinkedIn icons.

import Section from "./Section.astro";

interface Props {
  lang: "ro" | "en";
}

const { lang } = Astro.props;

const content = {
  ro: {
    eyebrow: "Contact",
    title: "Hai să vorbim",
    whatsapp: "Chat on WhatsApp",
    email: "me@somaticmusehealing.com",
  },
  en: {
    eyebrow: "Contact",
    title: "Let's talk",
    whatsapp: "Chat on WhatsApp",
    email: "me@somaticmusehealing.com",
  },
};

const t = content[lang];

const links = {
  whatsapp: "https://wa.me/40726173684",
  email: "mailto:me@somaticmusehealing.com",
  instagram: "https://www.instagram.com/somatic_muse/",
  linkedin: "https://www.linkedin.com/in/catrina-prager-reset-flow",
  substack: "https://keepsearching.substack.com/",
};
---

<Section id="contact" eyebrow={t.eyebrow} title={t.title} bg="mist">
  <div class="max-w-2xl mx-auto text-center">

    <div class="flex flex-col sm:flex-row gap-4 justify-center mb-10">
      <a href={links.whatsapp} target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center gap-2 px-6 py-3 bg-terracotta-600 hover:bg-terracotta-700 text-white rounded-full font-medium transition-colors" aria-label={t.whatsapp}>
        <svg viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" aria-hidden="true">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893A11.821 11.821 0 0 0 20.465 3.488"/>
        </svg>
        {t.whatsapp}
      </a>

      <a href={links.email} class="inline-flex items-center justify-center gap-2 px-6 py-3 bg-white border-2 border-terracotta-600 text-terracotta-700 hover:bg-terracotta-50 rounded-full font-medium transition-colors" aria-label={t.email}>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" aria-hidden="true">
          <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
          <polyline points="22,6 12,13 2,6"/>
        </svg>
        {t.email}
    </div>

    <div class="flex justify-center gap-6">
      <a href={links.instagram} target="_blank" rel="noopener noreferrer" class="text-slate-warm hover:text-terracotta-600 transition-colors" aria-label="Instagram">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg" class="w-7 h-7">
          <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/>
          <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/>
          <line x1="17.5" y1="6.5" x2="17.5" y2="6.5"/>
        </svg>
      </a>

      <a href={links.linkedin} target="_blank" rel="noopener noreferrer" class="text-slate-warm hover:text-terracotta-600 transition-colors" aria-label="LinkedIn">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg" class="w-7 h-7">
          <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/>
          <rect x="2" y="9" width="4" height="12"/>
          <circle cx="4" cy="4" r="2"/>
        </svg>
      </a>
      <a href={links.substack} target="_blank" rel="noopener noreferrer" class="text-slate-warm hover:text-terracotta-600 transition-colors" aria-label="Substack">
        <svg viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg" class="w-7 h-7">
          <path d="M22.539 8.242H1.46V5.406h21.08v2.836zM1.46 10.812V24L12 18.11 22.54 24V10.812H1.46zM22.54 0H1.46v2.836h21.08V0z"/>
        </svg>
      </a>
      
    </div>

  </div>
</Section>
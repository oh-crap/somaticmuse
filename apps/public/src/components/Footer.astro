---
interface Props {
  lang: "ro" | "en";
}
const { lang } = Astro.props;

const labels = {
  ro: {
    follow: "Urmărește-mă",
    rights: "Toate drepturile rezervate",
    tagline: "Yoga și terapie somatică în București",
  },
  en: {
    follow: "Follow me",
    rights: "All rights reserved",
    tagline: "Yoga and somatic healing in Bucharest",
  },
};
const t = labels[lang];
const year = new Date().getFullYear();

const links = {
  whatsapp: "https://wa.me/40726173684",
  email: "mailto:me@somaticmusehealing.com",
  instagram: "https://www.instagram.com/somatic_muse/",
  linkedin: "https://www.linkedin.com/in/catrina-prager-reset-flow",
};
---
<footer class="border-t border-mist bg-cream mt-auto">
  <div class="max-w-6xl mx-auto px-6 py-12 grid gap-8 md:grid-cols-2 items-start">
    <div class="text-center md:text-left">
      <div class="font-display text-xl text-ink mb-1">Somatic Muse Healing</div>
      <p class="text-sm text-slate-warm mb-4">{t.tagline}</p>
      <p class="text-xs text-slate-warm">© {year} Somatic Muse Healing. {t.rights}.</p>
    </div>
    <div class="flex flex-col items-center md:items-end gap-3">
      <p class="text-xs uppercase tracking-widest text-slate-warm">{t.follow}</p>
      <div class="flex items-center gap-5">

        <a href={links.whatsapp} target="_blank" rel="noopener noreferrer" aria-label="WhatsApp" class="text-slate-warm hover:text-terracotta-600 transition-colors">
          <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="currentColor">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893A11.821 11.821 0 0 0 20.465 3.488"/>
          </svg>
        </a>

        <a href={links.email} aria-label="Email" class="text-slate-warm hover:text-terracotta-600 transition-colors">
          <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
            <polyline points="22,6 12,13 2,6"/>
          </svg>
        </a>

        <a href={links.instagram} target="_blank" rel="noopener noreferrer" aria-label="Instagram" class="text-slate-warm hover:text-terracotta-600 transition-colors">
          <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/>
            <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/>
            <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/>
          </svg>
        </a>

        <a href={links.linkedin} target="_blank" rel="noopener noreferrer" aria-label="LinkedIn" class="text-slate-warm hover:text-terracotta-600 transition-colors">
          <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/>
            <rect x="2" y="9" width="4" height="12"/>
            <circle cx="4" cy="4" r="2"/>
          </svg>
        </a>

      </div>
    </div>
  </div>
</footer>
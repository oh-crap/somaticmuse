# ---------------------------------------------------------------------
# Supabase (admin app uses SERVICE ROLE key — server-side writes)
# ---------------------------------------------------------------------
# Same project URL as public app
SUPABASE_URL=

# Service role key — found in Supabase Settings > API > service_role
# NEVER expose to client. NEVER commit. Only used server-side in this app.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------
# Cloudflare Access (JWT validation in middleware)
# ---------------------------------------------------------------------
# Team domain prefix — your team URL is <prefix>.cloudflareaccess.com
# Find it: Zero Trust dashboard > Settings > Custom Pages > Team domain
CF_ACCESS_TEAM_DOMAIN=

# AUD tag of the Access application protecting admin.somaticmusehealing.com
# Find it: Zero Trust > Access > Applications > [admin app] > Overview
CF_ACCESS_AUD=
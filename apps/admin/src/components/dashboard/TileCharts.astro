---
// apps/admin/src/components/dashboard/TileCharts.astro
// Tile 5: Charts.
//
// Two stacked charts over a 12-month window ending at ?ch_end=YYYY-MM:
//   1. Combined: total visits (bars, left axis) + unique students (line, right axis)
//   2. Lessons per month broken down by studio (stacked bars)
//
// Both charts have native <title> tooltips on hover (no JS).

import { fetchChartData } from "../../lib/dashboard/charts";
import {
  renderBarLineChart,
  renderStackedBarChart,
  getStudioColor,
} from "../../lib/dashboard/svg";
import { preserveOtherTileParams } from "../../lib/dashboard/url";

const DATA_START = new Date(Date.UTC(2026, 5, 1));

function currentMonthStart(): Date {
  const now = new Date();
  return new Date(Date.UTC(now.getUTCFullYear(), now.getUTCMonth(), 1));
}

function parseEndMonth(raw: string | null): Date {
  let parsed: Date | null = null;
  const match = raw?.match(/^(\d{4})-(\d{2})$/);
  if (match) {
    const year = Number(match[1]);
    const month = Number(match[2]);
    if (month >= 1 && month <= 12 && year >= 2026 && year <= 2100) {
      parsed = new Date(Date.UTC(year, month - 1, 1));
    }
  }
  if (!parsed) parsed = currentMonthStart();
  const max = currentMonthStart();
  if (parsed.getTime() > max.getTime()) return max;
  if (parsed.getTime() < DATA_START.getTime()) return DATA_START;
  return parsed;
}

function formatYearMonth(d: Date): string {
  return `${d.getUTCFullYear()}-${String(d.getUTCMonth() + 1).padStart(2, "0")}`;
}

function formatMonthLabel(d: Date): string {
  return new Intl.DateTimeFormat("en-GB", {
    month: "short",
    timeZone: "UTC",
  }).format(d);
}

function formatPeriodLabel(d: Date): string {
  return new Intl.DateTimeFormat("en-GB", {
    month: "short",
    year: "numeric",
    timeZone: "UTC",
  }).format(d);
}

const url = Astro.url;
const endMonth = parseEndMonth(url.searchParams.get("ch_end"));
const otherParams = preserveOtherTileParams(url, "charts");

const chartData = await fetchChartData(endMonth);
const data = chartData.monthlyData;
const allStudios = chartData.allStudios;
const hasStudios = allStudios.length > 0;

const startLabel = formatPeriodLabel(data[0].month);
const endLabel = formatPeriodLabel(data[data.length - 1].month);

// Navigation: ±6 months, capped at boundaries
const rawPrevEnd = new Date(
  Date.UTC(endMonth.getUTCFullYear(), endMonth.getUTCMonth() - 6, 1),
);
const rawNextEnd = new Date(
  Date.UTC(endMonth.getUTCFullYear(), endMonth.getUTCMonth() + 6, 1),
);
const maxEnd = currentMonthStart();
const prevEnd =
  rawPrevEnd.getTime() < DATA_START.getTime() ? DATA_START : rawPrevEnd;
const nextEnd = rawNextEnd.getTime() > maxEnd.getTime() ? maxEnd : rawNextEnd;
const hasPrev = endMonth.getTime() > DATA_START.getTime();
const hasNext = endMonth.getTime() < maxEnd.getTime();

const monthLabels = data.map((d) => formatMonthLabel(d.month));

const chart1Svg = renderBarLineChart({
  bars: data.map((d) => d.total_visits),
  line: data.map((d) => d.unique_students),
  labels: monthLabels,
  barColor: "#3B82F6",
  lineColor: "#10B981",
  barTooltipLabel: "Total visits",
  lineTooltipLabel: "Unique students",
});

// Stacked bars per studio. Studios sorted alphabetically (from charts.ts),
// each gets a deterministic color from STUDIO_COLORS palette.
const segmentColors = allStudios.map((_, i) => getStudioColor(i));
const chart2Svg = renderStackedBarChart({
  bars: data.map((d) =>
    allStudios.map((s) => d.lessons_per_studio.get(s) ?? 0),
  ),
  segmentColors,
  segmentLabels: allStudios,
  labels: monthLabels,
});
---
<div class="bg-white border rounded-lg p-4 h-full">
  <h3 class="text-sm font-semibold text-gray-700 mb-3">Charts</h3>

  {/* Window navigation */}
  <div class="flex items-center justify-between mb-4 pb-3 border-b border-gray-100 text-xs gap-2">
    <form action="/dashboard#tile-charts" method="GET" class="inline">
      {otherParams.map((p) => (
        <input type="hidden" name={p.name} value={p.value} />
      ))}
      <input type="hidden" name="ch_end" value={formatYearMonth(prevEnd)} />
      <button
        type="submit"
        disabled={!hasPrev}
        class={`px-2 py-1 border rounded transition-colors whitespace-nowrap ${hasPrev ? "text-gray-700 hover:bg-gray-50" : "text-gray-300 cursor-not-allowed"}`}
      >
        ← −6 months
      </button>
    </form>

    <div class="text-gray-500 text-center">
      {startLabel} – {endLabel}
    </div>

    <form action="/dashboard#tile-charts" method="GET" class="inline">
      {otherParams.map((p) => (
        <input type="hidden" name={p.name} value={p.value} />
      ))}
      <input type="hidden" name="ch_end" value={formatYearMonth(nextEnd)} />
      <button
        type="submit"
        disabled={!hasNext}
        class={`px-2 py-1 border rounded transition-colors whitespace-nowrap ${hasNext ? "text-gray-700 hover:bg-gray-50" : "text-gray-300 cursor-not-allowed"}`}
      >
        +6 months →
      </button>
    </form>
  </div>

  {/* Chart 1: visits + unique students */}
  <div class="mb-4">
    <div class="flex flex-wrap items-center gap-x-4 gap-y-1 mb-1 text-xs text-gray-600">
      <span class="flex items-center gap-1">
        <span class="inline-block w-3 h-3 bg-blue-500 rounded-sm"></span>
        Total visits (left axis)
      </span>
      <span class="flex items-center gap-1">
        <span class="inline-block w-3 h-3 bg-green-500 rounded-full"></span>
        Unique students (right axis)
      </span>
    </div>
    <div set:html={chart1Svg} />
  </div>

  {/* Chart 2: lessons per month, stacked by studio */}
  <div>
    <div class="text-xs text-gray-600 mb-1">Lessons per month, by studio</div>
    <div set:html={chart2Svg} />
    {hasStudios && (
      <div class="flex flex-wrap gap-x-3 gap-y-1 mt-2 text-[10px] text-gray-600">
        {allStudios.map((studio, i) => (
          <span class="flex items-center gap-1">
            <span
              class="inline-block w-2.5 h-2.5 rounded-sm shrink-0"
              style={`background-color: ${getStudioColor(i)}`}
            ></span>
            <span class="truncate">{studio}</span>
          </span>
        ))}
      </div>
    )}
  </div>
</div>
---
import "../styles/global.css";

interface Props {
  title: string;
}

const { title } = Astro.props;
const pathname = Astro.url.pathname;

const navLinks = [
  { href: "/", label: "Courses", match: (p: string) => p === "/" || p.startsWith("/courses") },
  { href: "/testimonials", label: "Testimonials", match: (p: string) => p.startsWith("/testimonials") },
  { href: "/crm", label: "CRM", match: (p: string) => p.startsWith("/crm") },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title} — Somatic Muse Admin</title>
  </head>
  <body class="min-h-screen text-gray-900">
    <header class="bg-white border-b">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 py-4 flex items-center justify-between gap-4">
        <h1 class="text-lg font-semibold">Somatic Muse — Admin</h1>
        <div class="flex items-center gap-4 sm:gap-6 text-sm">
          <nav class="flex gap-3 sm:gap-4">
            {navLinks.map((link) => (
              <a
                href={link.href}
                class={link.match(pathname)
                  ? "text-blue-600 font-medium"
                  : "text-gray-500 hover:text-blue-600 transition-colors"}
              >
                {link.label}
              </a>
            ))}
          </nav>
          <form action="/api/republish" method="POST" class="hidden sm:inline" onsubmit="return confirm('Republish website now? This will trigger a Cloudflare Pages build (~1-2 min).');">
            <input type="hidden" name="redirect_to" value={Astro.url.pathname} />
            <button type="submit" class="px-3 py-1.5 bg-green-600 hover:bg-green-700 text-white rounded text-xs font-medium transition-colors">
              ↻ Republish
            </button>
          </form>
        </div>
      </div>
    </header>
    <main class="max-w-5xl mx-auto px-4 sm:px-6 py-6 sm:py-8">
      <slot />
    </main>
  </body>
</html>
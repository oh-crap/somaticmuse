---
import "../styles/global.css";

interface Props {
  title: string;
}

const { title } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title} — Somatic Muse Admin</title>
  </head>
  <body class="min-h-screen text-gray-900">
    <header class="bg-white border-b">
      <div class="max-w-5xl mx-auto px-6 py-4 flex items-center justify-between">
        <h1 class="text-lg font-semibold">Somatic Muse — Admin</h1>
        <nav class="text-sm flex gap-4">
          <a href="/" class="text-blue-600 hover:underline">Courses</a>
          <a href="/testimonials" class="text-blue-600 hover:underline">Testimonials</a>
        </nav>
      </div>
    </header>
    <main class="max-w-5xl mx-auto px-6 py-8">
      <slot />
    </main>
  </body>
</html>
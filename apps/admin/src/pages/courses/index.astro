---
import AdminLayout from "../../layouts/AdminLayout.astro";
import { supabaseAdmin, type Course } from "../../lib/supabase";
import { formatAdminDateTime, isPast } from "@somaticmuse/shared";

const PER_PAGE = 20;

// Pagination state from URL
const pageParam = Number(Astro.url.searchParams.get("page"));
const requestedPage =
  Number.isInteger(pageParam) && pageParam >= 1 ? pageParam : 1;

// Fetch total count first, so we can clamp page server-side and avoid
// rendering empty overflow pages.
const { count: totalCount, error: countError } = await supabaseAdmin
  .from("courses")
  .select("*", { count: "exact", head: true });

if (countError) {
  console.error("[Admin] Failed to count courses:", countError.message);
}

const total = totalCount ?? 0;
const totalPages = Math.max(1, Math.ceil(total / PER_PAGE));
const currentPage = Math.min(requestedPage, totalPages);
const offset = (currentPage - 1) * PER_PAGE;

// Fetch one page, newest first by start_at
const { data, error } = await supabaseAdmin
  .from("courses")
  .select("*")
  .order("start_at", { ascending: false })
  .range(offset, offset + PER_PAGE - 1)
  .returns<Course[]>();

if (error) {
  console.error("[Admin] Failed to fetch courses:", error.message);
}

const courses = data ?? [];

// Toast handling
const statusParam = Astro.url.searchParams.get("status");
const errorParam = Astro.url.searchParams.get("error");

const statusMessages: Record<string, string> = {
  created: "Course created successfully",
  updated: "Course updated successfully",
  deleted: "Course deleted",
  republished: "Republish triggered. Website will update in ~1-2 min.",
};

const successMessage = statusParam ? statusMessages[statusParam] : null;

// Pagination link helpers
const hasPrev = currentPage > 1;
const hasNext = currentPage < totalPages;
const prevHref = `/courses?page=${currentPage - 1}`;
const nextHref = `/courses?page=${currentPage + 1}`;
---
<AdminLayout title="Courses">
  <div class="flex items-center justify-between mb-6">
    <h2 class="text-2xl font-semibold">Courses</h2>
    <a href="/courses/new" class="inline-block px-4 py-2 bg-blue-600 text-white text-sm rounded hover:bg-blue-700 transition-colors">
      + New course
    </a>
  </div>

  {successMessage && (
    <div class="bg-green-50 border border-green-200 text-green-700 p-3 rounded mb-4 text-sm">
      {successMessage}
    </div>
  )}

  {errorParam && (
    <div class="bg-red-50 border border-red-200 text-red-700 p-3 rounded mb-4 text-sm">
      <strong>Error:</strong> {decodeURIComponent(errorParam)}
    </div>
  )}

  {error && (
    <div class="bg-red-50 border border-red-200 text-red-700 p-4 rounded mb-4">
      Error loading courses: {error.message}
    </div>
  )}

  {!error && total === 0 && (
    <p class="text-gray-500">No courses yet. Click "+ New course" to add the first one.</p>
  )}

  {total > 0 && (
    <div class="overflow-x-auto bg-white border rounded">
      <table class="w-full text-sm">
        <thead class="bg-gray-50 text-left text-xs uppercase text-gray-600 tracking-wider">
          <tr>
            <th class="px-4 py-3">When</th>
            <th class="px-4 py-3">Title</th>
            <th class="px-4 py-3">Style</th>
            <th class="px-4 py-3">Format</th>
            <th class="px-4 py-3">Studio</th>
            <th class="px-4 py-3 text-right">Actions</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-200">
          {courses.map((course) => (
            <tr class={isPast(course.end_at) ? "text-gray-400" : ""}>
              <td class="px-4 py-3 whitespace-nowrap">
                {formatAdminDateTime(course.start_at)}
                {isPast(course.end_at) && <span class="ml-2 text-xs text-gray-400">(past)</span>}
              </td>
              <td class="px-4 py-3">{course.title}</td>
              <td class="px-4 py-3">{course.yoga_style}</td>
              <td class="px-4 py-3 capitalize">{course.format}</td>
              <td class="px-4 py-3">{course.studio_name}</td>
              <td class="px-4 py-3 text-right whitespace-nowrap">
                <a href={`/courses/${course.id}/edit`} class="text-blue-600 hover:underline mr-3">Edit</a>
                <a href={`/courses/new?clone=${course.id}`} class="text-blue-600 hover:underline mr-3">Clone</a>
                <form
                  action={`/api/courses/${course.id}/delete`}
                  method="POST"
                  class="inline"
                  onsubmit="return confirm('Delete this course? This action cannot be undone.');"
                >
                  <button
                    type="submit"
                    class="text-red-600 hover:underline bg-transparent border-0 p-0 cursor-pointer"
                  >
                    Delete
                  </button>
                </form>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  )}

  {total > 0 && totalPages > 1 && (
    <div class="flex items-center justify-between mt-4 text-sm">
      <div class="text-gray-500">
        Page {currentPage} of {totalPages} · {total} {total === 1 ? "course" : "courses"} total
      </div>
      <div class="flex gap-2">
        {hasPrev ? (
          <a href={prevHref} class="px-3 py-1.5 border rounded text-gray-700 hover:bg-gray-50 transition-colors">
            ← Previous
          </a>
        ) : (
          <span class="px-3 py-1.5 border rounded text-gray-300 cursor-not-allowed">
            ← Previous
          </span>
        )}
        {hasNext ? (
          <a href={nextHref} class="px-3 py-1.5 border rounded text-gray-700 hover:bg-gray-50 transition-colors">
            Next →
          </a>
        ) : (
          <span class="px-3 py-1.5 border rounded text-gray-300 cursor-not-allowed">
            Next →
          </span>
        )}
      </div>
    </div>
  )}
</AdminLayout>
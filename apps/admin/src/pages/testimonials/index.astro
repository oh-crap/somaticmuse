---
// apps/admin/src/pages/testimonials/index.astro
// Testimonials list page — analog to courses index.

import AdminLayout from "../../layouts/AdminLayout.astro";
import { supabaseAdmin, type Testimonial } from "../../lib/supabase";

// Fetch all testimonials ordered by display_order
const { data, error } = await supabaseAdmin
  .from("testimonials")
  .select("*")
  .order("display_order", { ascending: true })
  .returns<Testimonial[]>();

if (error) {
  console.error("[Admin] Failed to fetch testimonials:", error.message);
}

const testimonials = data ?? [];

// Truncate long content for table display
const truncate = (text: string, max = 100) => {
  return text.length <= max ? text : text.slice(0, max - 1).trimEnd() + "…";
};

// Toast handling
const statusParam = Astro.url.searchParams.get("status");
const errorParam = Astro.url.searchParams.get("error");

const statusMessages: Record<string, string> = {
  created: "Testimonial created successfully",
  updated: "Testimonial updated successfully",
  deleted: "Testimonial deleted successfully",
};

const successMessage = statusParam ? statusMessages[statusParam] : null;
---
<AdminLayout title="Testimonials">
  <div class="flex items-center justify-between mb-6">
    <h2 class="text-2xl font-semibold">Testimonials</h2>
    <a href="/testimonials/new" class="inline-block px-4 py-2 bg-blue-600 text-white text-sm rounded hover:bg-blue-700 transition-colors">
      + New testimonial
    </a>
  </div>

  {successMessage && (
    <div class="bg-green-50 border border-green-200 text-green-700 p-3 rounded mb-4 text-sm">
      {successMessage}
    </div>
  )}

  {errorParam && (
    <div class="bg-red-50 border border-red-200 text-red-700 p-3 rounded mb-4 text-sm">
      <strong>Error:</strong> {decodeURIComponent(errorParam)}
    </div>
  )}

  {error && (
    <div class="bg-red-50 border border-red-200 text-red-700 p-4 rounded mb-4">
      Error loading testimonials: {error.message}
    </div>
  )}

  {!error && testimonials.length === 0 && (
    <p class="text-gray-500">No testimonials yet. Click "+ New testimonial" to add the first one.</p>
  )}

  {testimonials.length > 0 && (
    <div class="overflow-x-auto bg-white border rounded">
      <table class="w-full text-sm">
        <thead class="bg-gray-50 text-left text-xs uppercase text-gray-600 tracking-wider">
          <tr>
            <th class="px-4 py-3 w-16">Order</th>
            <th class="px-4 py-3">Name</th>
            <th class="px-4 py-3">Role / Location</th>
            <th class="px-4 py-3">Content</th>
            <th class="px-4 py-3 text-center w-20">Photo</th>
            <th class="px-4 py-3 text-center w-20">Visible</th>
            <th class="px-4 py-3 text-right">Actions</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-200">
          {testimonials.map((t) => (
            <tr class={!t.visible ? "text-gray-400" : ""}>
              <td class="px-4 py-3 font-mono">{t.display_order}</td>
              <td class="px-4 py-3 font-medium">{t.name}</td>
              <td class="px-4 py-3">{t.role_or_location ?? "—"}</td>
              <td class="px-4 py-3">{truncate(t.content)}</td>
              <td class="px-4 py-3 text-center">{t.photo_url ? "✓" : "—"}</td>
              <td class="px-4 py-3 text-center">
                {t.visible ? <span class="text-green-600">✓</span> : <span class="text-gray-400">hidden</span>}
              </td>
              <td class="px-4 py-3 text-right whitespace-nowrap">
                <a href={`/testimonials/${t.id}/edit`} class="text-blue-600 hover:underline mr-3">Edit</a>
                <form action={`/api/testimonials/${t.id}/delete`} method="POST" class="inline" onsubmit="return confirm('Delete this testimonial? This action cannot be undone.');">
                  <button type="submit" class="text-red-600 hover:underline bg-transparent border-0 p-0 cursor-pointer">Delete</button>
                </form>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  )}
</AdminLayout>
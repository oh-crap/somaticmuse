---
// apps/admin/src/pages/crm/index.astro
// CRM homepage — 3 upcoming courses with enrolled students,
// action buttons, and sleeping clients list.

import AdminLayout from "../../layouts/AdminLayout.astro";
import { supabaseAdmin } from "../../lib/supabase";
import type { Course, SleepingStudent } from "@somaticmuse/shared";

// -----------------------------------------------------------------
// 1. Three upcoming courses with enrolled students
// -----------------------------------------------------------------
const now = new Date().toISOString();

const { data: coursesRaw, error: coursesError } = await supabaseAdmin
  .from("courses")
  .select(`
    id, title, yoga_style, format, start_at, end_at,
    studio_name, studio_address,
    course_students (
      students (id, first_name, last_name, photo_url)
    )
  `)
  .gt("start_at", now)
  .order("start_at", { ascending: true })
  .limit(3);

if (coursesError) {
  console.error("[CRM] Failed to fetch upcoming courses:", coursesError.message);
}

// Flatten the nested Supabase response into a clean shape
interface UpcomingCourse {
  id: string;
  title: string;
  yoga_style: string;
  format: string;
  start_at: string;
  end_at: string;
  studio_name: string;
  students: { id: string; first_name: string; last_name: string; photo_url: string | null }[];
}

const upcomingCourses: UpcomingCourse[] = (coursesRaw ?? []).map((c: any) => ({
  id: c.id,
  title: c.title,
  yoga_style: c.yoga_style,
  format: c.format,
  start_at: c.start_at,
  end_at: c.end_at,
  studio_name: c.studio_name,
  students: (c.course_students ?? [])
    .map((cs: any) => cs.students)
    .filter(Boolean)
    .sort((a: any, b: any) => a.last_name.localeCompare(b.last_name)),
}));

// -----------------------------------------------------------------
// 2. Sleeping students (from DB view)
// -----------------------------------------------------------------
const { data: sleepingRaw, error: sleepingError } = await supabaseAdmin
  .from("sleeping_students")
  .select("*")
  .order("last_attended_at", { ascending: true });

if (sleepingError) {
  console.error("[CRM] Failed to fetch sleeping students:", sleepingError.message);
}

const sleepingStudents: SleepingStudent[] = (sleepingRaw as SleepingStudent[]) ?? [];

// -----------------------------------------------------------------
// Helpers
// -----------------------------------------------------------------
const formatDateTime = (iso: string) => {
  return new Intl.DateTimeFormat("en-GB", {
    weekday: "short",
    day: "2-digit",
    month: "short",
    hour: "2-digit",
    minute: "2-digit",
    hour12: false,
    timeZone: "Europe/Bucharest",
  }).format(new Date(iso));
};

const formatDateShort = (iso: string) => {
  return new Intl.DateTimeFormat("en-GB", {
    day: "2-digit",
    month: "short",
    timeZone: "Europe/Bucharest",
  }).format(new Date(iso));
};

const daysAgo = (iso: string) => {
  const diff = Date.now() - new Date(iso).getTime();
  const days = Math.floor(diff / (1000 * 60 * 60 * 24));
  if (days === 0) return "today";
  if (days === 1) return "1 day ago";
  return `${days} days ago`;
};

const initials = (first: string, last: string) =>
  `${first.charAt(0)}${last.charAt(0)}`.toUpperCase();
---
<AdminLayout title="CRM">
  <!-- ============================================================ -->
  <!-- MOBILE: action buttons horizontal scroll                     -->
  <!-- ============================================================ -->
  <div class="flex flex-wrap gap-2 mb-6 md:hidden">
    <a href="/crm/students/search" class="flex-1 min-w-[calc(50%-0.25rem)] px-3 py-2.5 bg-white border rounded text-sm text-center text-gray-700 hover:bg-gray-50 transition-colors">
      🔍 Search
    </a>
    <a href="/crm/students" class="flex-1 min-w-[calc(50%-0.25rem)] px-3 py-2.5 bg-white border rounded text-sm text-center text-gray-700 hover:bg-gray-50 transition-colors">
      📋 A–Z list
    </a>
    <a href="/crm/students/new" class="flex-1 min-w-[calc(50%-0.25rem)] px-3 py-2.5 bg-blue-600 text-white rounded text-sm text-center hover:bg-blue-700 transition-colors">
      + Add student
    </a>
    <a href="/crm/tags" class="flex-1 min-w-[calc(50%-0.25rem)] px-3 py-2.5 bg-white border rounded text-sm text-center text-gray-700 hover:bg-gray-50 transition-colors">
      🏷️ Tags
    </a>
  </div>

  <!-- ============================================================ -->
  <!-- MAIN GRID: courses (left) + sidebar (right)                  -->
  <!-- ============================================================ -->
  <div class="grid grid-cols-1 md:grid-cols-[1fr_260px] gap-6">

    <!-- ========== LEFT: Upcoming courses ========================= -->
    <div>
      <h2 class="text-lg font-semibold mb-4">Upcoming courses</h2>

      {coursesError && (
        <div class="bg-red-50 border border-red-200 text-red-700 p-3 rounded mb-4 text-sm">
          Error loading courses: {coursesError.message}
        </div>
      )}

      {!coursesError && upcomingCourses.length === 0 && (
        <p class="text-gray-500 text-sm">No upcoming courses.</p>
      )}

      <div class="space-y-4">
        {upcomingCourses.map((course) => (
          <div class="bg-white border rounded-lg overflow-hidden">
            {/* Course header */}
            <div class="px-4 py-3 border-b bg-gray-50">
              <div class="flex flex-wrap items-baseline justify-between gap-x-3 gap-y-1">
                <h3 class="font-medium text-gray-900">{course.title}</h3>
                <span class="text-xs text-gray-500">{formatDateTime(course.start_at)}</span>
              </div>
              <div class="flex flex-wrap gap-x-3 gap-y-1 mt-1 text-xs text-gray-500">
                <span>{course.yoga_style}</span>
                <span>·</span>
                <span class="capitalize">{course.format}</span>
                <span>·</span>
                <span>{course.studio_name}</span>
              </div>
            </div>

            {/* Enrolled students */}
            <div class="px-4 py-3">
              {course.students.length === 0 ? (
                <p class="text-sm text-gray-400 italic">No students enrolled yet.</p>
              ) : (
                <div class="flex flex-wrap gap-2">
                  {course.students.map((student) => (
                    <a
                      href={`/crm/students/${student.id}`}
                      class="inline-flex items-center gap-2 px-3 py-1.5 bg-gray-50 hover:bg-blue-50 border rounded-full text-sm transition-colors group"
                    >
                      {student.photo_url ? (
                        <img
                          src={student.photo_url}
                          alt=""
                          class="w-6 h-6 rounded-full object-cover"
                        />
                      ) : (
                        <span class="w-6 h-6 rounded-full bg-gray-200 text-gray-600 text-[10px] font-medium flex items-center justify-center">
                          {initials(student.first_name, student.last_name)}
                        </span>
                      )}
                      <span class="text-gray-700 group-hover:text-blue-600">
                        {student.first_name} {student.last_name}
                      </span>
                    </a>
                  ))}
                </div>
              )}
              <div class="mt-2 text-xs text-gray-400">
                {course.students.length} {course.students.length === 1 ? "student" : "students"}
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- ========== RIGHT: Sidebar ================================= -->
    <div class="space-y-6">

      {/* Action buttons — desktop only (mobile version is above) */}
      <div class="hidden md:flex flex-col gap-2">
        <a href="/crm/students/search" class="px-4 py-2.5 bg-white border rounded text-sm text-gray-700 hover:bg-gray-50 transition-colors">
          🔍 Search students
        </a>
        <a href="/crm/students" class="px-4 py-2.5 bg-white border rounded text-sm text-gray-700 hover:bg-gray-50 transition-colors">
          📋 Alphabetical list
        </a>
        <a href="/crm/students/new" class="px-4 py-2.5 bg-blue-600 text-white rounded text-sm text-center hover:bg-blue-700 transition-colors">
          + Add student
        </a>
        <a href="/crm/tags" class="px-4 py-2.5 bg-white border rounded text-sm text-gray-700 hover:bg-gray-50 transition-colors">
          🏷️ Manage tags
        </a>
      </div>

      {/* Sleeping clients */}
      <div>
        <h2 class="text-lg font-semibold mb-3">Sleeping clients</h2>

        {sleepingError && (
          <div class="bg-red-50 border border-red-200 text-red-700 p-3 rounded text-sm">
            Error: {sleepingError.message}
          </div>
        )}

        {!sleepingError && sleepingStudents.length === 0 && (
          <p class="text-sm text-gray-400">No sleeping clients right now.</p>
        )}

        {sleepingStudents.length > 0 && (
          <div class="bg-white border rounded-lg divide-y">
            {sleepingStudents.map((s) => (
              <a
                href={`/crm/students/${s.id}`}
                class="flex items-center gap-3 px-3 py-2.5 hover:bg-yellow-50 transition-colors group"
              >
                {/* Avatar */}
                {s.photo_url ? (
                  <img src={s.photo_url} alt="" class="w-8 h-8 rounded-full object-cover shrink-0" />
                ) : (
                  <span class="w-8 h-8 rounded-full bg-gray-200 text-gray-600 text-xs font-medium flex items-center justify-center shrink-0">
                    {initials(s.first_name, s.last_name)}
                  </span>
                )}

                {/* Name + meta */}
                <div class="min-w-0 flex-1">
                  <div class="text-sm font-medium text-gray-900 group-hover:text-blue-600 truncate">
                    {s.first_name} {s.last_name}
                  </div>
                  <div class="text-[11px] text-gray-400 truncate">
                    Last: {daysAgo(s.last_attended_at)} · {s.past_course_count} courses
                  </div>
                  {s.next_course_title && (
                    <div class="text-[11px] text-green-600 truncate mt-0.5">
                      ↳ Next: {s.next_course_title} ({formatDateShort(s.next_course_start_at!)})
                    </div>
                  )}
                </div>
              </a>
            ))}
          </div>
        )}
      </div>

    </div>
  </div>
</AdminLayout>
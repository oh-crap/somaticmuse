---
// apps/admin/src/pages/crm/students/new.astro
// Form to create a new student.

import AdminLayout from "../../../layouts/AdminLayout.astro";

const errorParam = Astro.url.searchParams.get("error");
const courseId = Astro.url.searchParams.get("course_id") ?? "";
---
<AdminLayout title="Add student">
  <div class="mb-6">
    <a href="/" class="text-sm text-blue-600 hover:underline">← Back to CRM</a>
  </div>

  <h2 class="text-2xl font-semibold mb-6">Add new student</h2>

  {errorParam && (
    <div class="bg-red-50 border border-red-200 text-red-700 p-3 rounded mb-4 text-sm">
      <strong>Error:</strong> {decodeURIComponent(errorParam)}
    </div>
  )}

  {courseId && (
    <div class="bg-blue-50 border border-blue-200 text-blue-700 p-3 rounded mb-4 text-sm">
      Student will be automatically enrolled in the selected course after creation.
    </div>
  )}

  <form action="/api/crm/students" method="POST" class="space-y-5 max-w-2xl">
    {courseId && <input type="hidden" name="course_id" value={courseId} />}
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div>
        <label for="first_name" class="block text-sm font-medium mb-1">First name *</label>
        <input
          type="text" id="first_name" name="first_name" required
          class="w-full px-3 py-2 border rounded focus:outline-none focus:ring-2 focus:ring-blue-500"
        />
      </div>
      <div>
        <label for="last_name" class="block text-sm font-medium mb-1">Last name *</label>
        <input
          type="text" id="last_name" name="last_name" required
          class="w-full px-3 py-2 border rounded focus:outline-none focus:ring-2 focus:ring-blue-500"
        />
      </div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div>
        <label for="email" class="block text-sm font-medium mb-1">Email</label>
        <input
          type="email" id="email" name="email"
          placeholder="student@example.com"
          class="w-full px-3 py-2 border rounded focus:outline-none focus:ring-2 focus:ring-blue-500"
        />
      </div>
      <div>
        <label for="phone" class="block text-sm font-medium mb-1">Phone</label>
        <input
          type="tel" id="phone" name="phone"
          placeholder="+40 7xx xxx xxx"
          class="w-full px-3 py-2 border rounded focus:outline-none focus:ring-2 focus:ring-blue-500"
        />
      </div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div>
        <label for="facebook_url" class="block text-sm font-medium mb-1">Facebook</label>
        <input
          type="url" id="facebook_url" name="facebook_url"
          placeholder="https://facebook.com/..."
          class="w-full px-3 py-2 border rounded focus:outline-none focus:ring-2 focus:ring-blue-500"
        />
      </div>
      <div>
        <label for="instagram_url" class="block text-sm font-medium mb-1">Instagram</label>
        <input
          type="url" id="instagram_url" name="instagram_url"
          placeholder="https://instagram.com/..."
          class="w-full px-3 py-2 border rounded focus:outline-none focus:ring-2 focus:ring-blue-500"
        />
      </div>
    </div>

    <div class="flex items-center gap-3 pt-4 border-t">
      <button type="submit" class="px-5 py-2 bg-blue-600 text-white rounded hover:bg-blue-700 transition-colors">
        Create student
      </button>
      <a href="/crm" class="text-sm text-gray-600 hover:underline">Cancel</a>
    </div>

  </form>
</AdminLayout>
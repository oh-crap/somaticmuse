---
// apps/admin/src/pages/crm/students/filter.astro
// Filter students by tags with AND/OR logic.

import AdminLayout from "../../../layouts/AdminLayout.astro";
import { supabaseAdmin } from "../../../lib/supabase";
import type { Tag, TagType, Student } from "@somaticmuse/shared";

// -----------------------------------------------------------------
// 1. Parse query params
// -----------------------------------------------------------------
const selectedTagIds = (Astro.url.searchParams.get("tags") ?? "")
  .split(",")
  .map(s => s.trim())
  .filter(Boolean);

const mode = Astro.url.searchParams.get("mode") === "or" ? "or" : "and";

// -----------------------------------------------------------------
// 2. Fetch all tags grouped by type
// -----------------------------------------------------------------
const { data: allTagsRaw, error: tagsError } = await supabaseAdmin
  .from("tags")
  .select("*")
  .order("type")
  .order("value")
  .returns<Tag[]>();

const allTags = allTagsRaw ?? [];

const grouped: Record<TagType, Tag[]> = {
  studio: [],
  yoga_style: [],
  format: [],
};
allTags.forEach(t => {
  if (grouped[t.type as TagType]) grouped[t.type as TagType].push(t);
});

const typeLabels: Record<TagType, string> = {
  studio: "Studios",
  yoga_style: "Yoga styles",
  format: "Formats",
};
const typeOrder: TagType[] = ["studio", "yoga_style", "format"];

// -----------------------------------------------------------------
// 3. Query matching students (if tags selected)
// -----------------------------------------------------------------
type StudentRow = Pick<Student, "id" | "first_name" | "last_name" | "photo_url" | "email" | "phone" | "active">;

let students: StudentRow[] = [];
let queryError: string | null = null;

if (selectedTagIds.length > 0) {
  if (mode === "or") {
    // OR: students who have ANY of the selected tags
    const { data, error } = await supabaseAdmin
      .from("student_tags")
      .select("student_id, students (id, first_name, last_name, photo_url, email, phone, active)")
      .in("tag_id", selectedTagIds);

    if (error) {
      queryError = error.message;
    } else {
      // Deduplicate by student ID
      const seen = new Set<string>();
      students = (data ?? [])
        .map((row: any) => row.students)
        .filter((s: any) => {
          if (!s || seen.has(s.id)) return false;
          seen.add(s.id);
          return true;
        })
        .sort((a: StudentRow, b: StudentRow) => a.last_name.localeCompare(b.last_name));
    }
  } else {
    // AND: students who have ALL selected tags
    // Strategy: for each tag, get student IDs, then intersect
    const sets: Set<string>[] = [];

    for (const tagId of selectedTagIds) {
      const { data, error } = await supabaseAdmin
        .from("student_tags")
        .select("student_id")
        .eq("tag_id", tagId);

      if (error) {
        queryError = error.message;
        break;
      }

      sets.push(new Set((data ?? []).map((r: any) => r.student_id)));
    }

    if (!queryError && sets.length > 0) {
      // Intersect all sets
      const intersection = sets.reduce((acc, set) =>
        new Set([...acc].filter(id => set.has(id)))
      );

      if (intersection.size > 0) {
        const { data, error } = await supabaseAdmin
          .from("students")
          .select("id, first_name, last_name, photo_url, email, phone, active")
          .in("id", [...intersection])
          .order("last_name")
          .order("first_name")
          .returns<StudentRow[]>();

        if (error) {
          queryError = error.message;
        } else {
          students = data ?? [];
        }
      }
    }
  }
}

const initials = (f: string, l: string) => `${f.charAt(0)}${l.charAt(0)}`.toUpperCase();
const selectedSet = new Set(selectedTagIds);
---
<AdminLayout title="Filter by tags">
  <div class="mb-6">
    <a href="/crm" class="text-sm text-blue-600 hover:underline">← Back to CRM</a>
    <h2 class="text-2xl font-semibold mt-1">Filter students by tags</h2>
  </div>

  {tagsError && (
    <div class="bg-red-50 border border-red-200 text-red-700 p-3 rounded mb-4 text-sm">
      Error loading tags: {tagsError.message}
    </div>
  )}

  <form method="GET" action="/crm/students/filter" id="filter-form">

    {/* AND/OR toggle */}
    <div class="flex items-center gap-3 mb-4">
      <span class="text-sm text-gray-600">Match:</span>
      <label class:list={["px-3 py-1.5 rounded-full text-sm cursor-pointer transition-colors border", mode === "and" ? "bg-blue-600 text-white border-blue-600" : "bg-white text-gray-600 border-gray-300 hover:bg-gray-50"]}>
        <input type="radio" name="mode" value="and" checked={mode === "and"} class="sr-only" onchange="this.form.submit()" />
        All selected (AND)
      </label>
      <label class:list={["px-3 py-1.5 rounded-full text-sm cursor-pointer transition-colors border", mode === "or" ? "bg-blue-600 text-white border-blue-600" : "bg-white text-gray-600 border-gray-300 hover:bg-gray-50"]}>
        <input type="radio" name="mode" value="or" checked={mode === "or"} class="sr-only" onchange="this.form.submit()" />
        Any selected (OR)
      </label>
    </div>

    {/* Tag selection */}
    <div class="space-y-4 mb-6">
      {typeOrder.map(type => {
        const typeTags = grouped[type];
        if (typeTags.length === 0) return null;
        return (
          <div>
            <h3 class="text-xs font-semibold text-gray-400 uppercase tracking-wider mb-2">{typeLabels[type]}</h3>
            <div class="flex flex-wrap gap-2">
              {typeTags.map(tag => {
                const isSelected = selectedSet.has(tag.id);
                return (
                  <label
                    class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-sm cursor-pointer transition-all border"
                    style={isSelected
                      ? `background-color: ${tag.color}; color: white; border-color: ${tag.color};`
                      : `border-color: ${tag.color}33; color: ${tag.color};`}
                  >
                    <input
                      type="checkbox"
                      name="tag"
                      value={tag.id}
                      checked={isSelected}
                      class="sr-only"
                      onchange="updateTags()"
                    />
                    {tag.value}
                  </label>
                );
              })}
            </div>
          </div>
        );
      })}
    </div>

    {/* Hidden field for aggregated tag IDs — filled by JS */}
    <input type="hidden" name="tags" id="tags-hidden" value={selectedTagIds.join(",")} />

  </form>

  {/* Results */}
  {selectedTagIds.length > 0 && (
    <div>
      <div class="flex items-center justify-between mb-3">
        <p class="text-sm text-gray-500">
          {students.length} {students.length === 1 ? "student" : "students"} found
          <span class="text-gray-400 ml-1">({mode.toUpperCase()} mode)</span>
        </p>
        <a href="/crm/students/filter" class="text-xs text-red-500 hover:text-red-700">Clear all</a>
      </div>

      {queryError && (
        <div class="bg-red-50 border border-red-200 text-red-700 p-3 rounded mb-4 text-sm">
          Error: {queryError}
        </div>
      )}

      {students.length > 0 && (
        <div class="bg-white border rounded-lg divide-y">
          {students.map(s => (
            <a
              href={`/crm/students/${s.id}`}
              class:list={[
                "flex items-center gap-3 px-4 py-3 hover:bg-gray-50 transition-colors group",
                !s.active && "opacity-50",
              ]}
            >
              {s.photo_url ? (
                <img src={s.photo_url} alt="" class="w-9 h-9 rounded-full object-cover shrink-0" />
              ) : (
                <span class="w-9 h-9 rounded-full bg-gray-200 text-gray-600 text-xs font-medium flex items-center justify-center shrink-0">
                  {initials(s.first_name, s.last_name)}
                </span>
              )}
              <div class="min-w-0 flex-1">
                <div class="text-sm font-medium text-gray-900 group-hover:text-blue-600 truncate">
                  {s.first_name} {s.last_name}
                  {!s.active && <span class="ml-2 text-xs text-gray-400 font-normal">(inactive)</span>}
                </div>
                {(s.email || s.phone) && (
                  <div class="text-xs text-gray-400 truncate">
                    {[s.email, s.phone].filter(Boolean).join(" · ")}
                  </div>
                )}
              </div>
              <svg class="w-4 h-4 text-gray-300 group-hover:text-blue-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            </a>
          ))}
        </div>
      )}
    </div>
  )}

  {selectedTagIds.length === 0 && (
    <p class="text-sm text-gray-400">Select one or more tags above to filter students.</p>
  )}
</AdminLayout>

<script>
  function updateTags() {
    const form = document.getElementById("filter-form") as HTMLFormElement;
    const checkboxes = form.querySelectorAll<HTMLInputElement>('input[name="tag"]');
    const selected = Array.from(checkboxes)
      .filter(cb => cb.checked)
      .map(cb => cb.value);
    const hidden = document.getElementById("tags-hidden") as HTMLInputElement;
    hidden.value = selected.join(",");
    form.submit();
  }

  // Make updateTags available globally for inline onchange
  (window as any).updateTags = updateTags;
</script>
---
// apps/admin/src/pages/crm/tags/index.astro
// Tag management — view, recolor, add, delete tags.

import AdminLayout from "../../../layouts/AdminLayout.astro";
import { supabaseAdmin } from "../../../lib/supabase";
import type { Tag, TagType } from "@somaticmuse/shared";

const { data, error } = await supabaseAdmin
  .from("tags")
  .select("*")
  .order("type", { ascending: true })
  .order("value", { ascending: true })
  .returns<Tag[]>();

if (error) {
  console.error("[CRM] Failed to fetch tags:", error.message);
}

const tags = data ?? [];

// Group by type
const grouped: Record<TagType, Tag[]> = {
  studio: [],
  yoga_style: [],
  format: [],
};

tags.forEach((t) => {
  if (grouped[t.type as TagType]) {
    grouped[t.type as TagType].push(t);
  }
});

const typeLabels: Record<TagType, string> = {
  studio: "Studios",
  yoga_style: "Yoga styles",
  format: "Formats",
};

const typeOrder: TagType[] = ["studio", "yoga_style", "format"];

// Count how many students use each tag
const { data: tagCounts } = await supabaseAdmin
  .from("student_tags")
  .select("tag_id");

const countMap: Record<string, number> = {};
(tagCounts ?? []).forEach((row: any) => {
  countMap[row.tag_id] = (countMap[row.tag_id] ?? 0) + 1;
});

// Toasts
const statusParam = Astro.url.searchParams.get("status");
const errorParam = Astro.url.searchParams.get("error");
const statusMessages: Record<string, string> = {
  created: "Tag created",
  deleted: "Tag deleted",
  color_updated: "Color updated",
};
const successMessage = statusParam ? statusMessages[statusParam] : null;
---
<AdminLayout title="Manage tags">
  <div class="mb-6">
    <a href="/crm" class="text-sm text-blue-600 hover:underline">← Back to CRM</a>
    <h2 class="text-2xl font-semibold mt-1">Manage tags</h2>
    <p class="text-sm text-gray-500 mt-1">Tags are auto-created when students enroll in courses. You can change colors, add new tags, or delete unused ones.</p>
  </div>

  {successMessage && (
    <div class="bg-green-50 border border-green-200 text-green-700 p-3 rounded mb-4 text-sm">{successMessage}</div>
  )}
  {errorParam && (
    <div class="bg-red-50 border border-red-200 text-red-700 p-3 rounded mb-4 text-sm">
      <strong>Error:</strong> {decodeURIComponent(errorParam)}
    </div>
  )}

  {error && (
    <div class="bg-red-50 border border-red-200 text-red-700 p-4 rounded mb-4">
      Error loading tags: {error.message}
    </div>
  )}

  {/* Add new tag */}
  <div class="bg-white border rounded-lg p-4 mb-6">
    <h3 class="text-sm font-semibold mb-3">Add tag</h3>
    <form action="/api/crm/tags" method="POST" class="flex flex-wrap gap-2 items-end">
      <div>
        <label for="tag-type" class="block text-xs text-gray-500 mb-1">Type</label>
        <select id="tag-type" name="type" required class="px-3 py-2 border rounded text-sm bg-white">
          <option value="studio">Studio</option>
          <option value="yoga_style">Yoga style</option>
          <option value="format">Format</option>
        </select>
      </div>
      <div class="flex-1 min-w-45">
        <label for="tag-value" class="block text-xs text-gray-500 mb-1">Value</label>
        <input
          type="text" id="tag-value" name="value" required
          placeholder="e.g. Hatha, Studio Zen…"
          class="w-full px-3 py-2 border rounded text-sm focus:outline-none focus:ring-2 focus:ring-blue-500"
        />
      </div>
      <button type="submit" class="px-4 py-2 bg-blue-600 text-white rounded text-sm hover:bg-blue-700 transition-colors">
        Add
      </button>
    </form>
  </div>

  {/* Tag groups */}
  <div class="space-y-6">
    {typeOrder.map((type) => {
      const typeTags = grouped[type];
      return (
        <div>
          <h3 class="text-sm font-semibold text-gray-700 mb-2">
            {typeLabels[type]}
            <span class="text-gray-400 font-normal ml-1">({typeTags.length})</span>
          </h3>

          {typeTags.length === 0 ? (
            <p class="text-sm text-gray-400 italic">No tags of this type yet.</p>
          ) : (
            <div class="bg-white border rounded-lg divide-y">
              {typeTags.map((tag) => {
                const studentCount = countMap[tag.id] ?? 0;
                return (
                  <div class="flex items-center gap-3 px-4 py-3">
                    {/* Color swatch + picker */}
                    <form action={`/api/crm/tags/${tag.id}`} method="POST" class="flex items-center gap-2 shrink-0">
                      <input type="hidden" name="action" value="update_color" />
                      <input
                        type="color" name="color" value={tag.color}
                        class="w-8 h-8 rounded border cursor-pointer p-0"
                        title="Change color"
                        onchange="this.form.submit()"
                      />
                    </form>

                    {/* Tag info */}
                    <div class="min-w-0 flex-1">
                      <div class="flex items-center gap-2">
                        <span
                          class="inline-block px-2 py-0.5 rounded-full text-xs font-medium text-white"
                          style={`background-color: ${tag.color}`}
                        >
                          {tag.value}
                        </span>
                        <span class="text-xs text-gray-400">
                          {studentCount} {studentCount === 1 ? "student" : "students"}
                        </span>
                      </div>
                    </div>

                    {/* Delete */}
                    <form
                      action={`/api/crm/tags/${tag.id}`}
                      method="POST"
                      onsubmit={`return confirm('Delete tag "${tag.value}"? It will be removed from all students.')`}
                      class="shrink-0"
                    >
                      <input type="hidden" name="action" value="delete" />
                      <button type="submit" class="text-red-400 hover:text-red-600 transition-colors text-xs">
                        Delete
                      </button>
                    </form>
                  </div>
                );
              })}
            </div>
          )}
        </div>
      );
    })}
  </div>
</AdminLayout>
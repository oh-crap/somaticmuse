---
const videoUrl = "https://imglink.cc/cdn/3R1oehx6x8.mp4";
---
<div
  class="hidden md:block motion-reduce:hidden fixed inset-0 -z-10 pointer-events-none"
  aria-hidden="true"
>
  <video
    autoplay
    loop
    muted
    playsinline
    preload="auto"
    class="w-full h-full object-cover"
  >
    <source src={videoUrl} type="video/mp4" />
  </video>
</div>
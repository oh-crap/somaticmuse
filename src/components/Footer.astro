---
interface Props {
  lang: "ro" | "en";
}

const { lang } = Astro.props;

const labels = {
  ro: {
    follow: "Urmărește-mă",
    rights: "Toate drepturile rezervate",
    tagline: "Yoga și terapie somatică în București",
  },
  en: {
    follow: "Follow me",
    rights: "All rights reserved",
    tagline: "Yoga and somatic healing in Bucharest",
  },
};

const t = labels[lang];
const year = new Date().getFullYear();

// Placeholder social URLs — replace with real ones later
const socials = [
  { name: "Instagram", url: "https://instagram.com/placeholder" },
  { name: "LinkedIn", url: "https://linkedin.com/in/placeholder" },
  { name: "Facebook", url: "https://facebook.com/placeholder" },
];
---
<footer class="border-t border-mist bg-cream mt-auto">
  <div class="max-w-6xl mx-auto px-6 py-12 grid gap-8 md:grid-cols-2 items-start">

    <div class="text-center md:text-left">
      <div class="font-display text-xl text-ink mb-1">Somatic Muse Healing</div>
      <p class="text-sm text-slate-warm mb-4">{t.tagline}</p>
      <p class="text-xs text-slate-warm">© {year} Somatic Muse Healing. {t.rights}.</p>
    </div>

    <div class="flex flex-col items-center md:items-end gap-3">
      <p class="text-xs uppercase tracking-widest text-slate-warm">{t.follow}</p>
      <div class="flex items-center gap-5">

        <a href={socials[0].url} target="_blank" rel="noopener noreferrer" aria-label="Instagram" class="text-slate-warm hover:text-terracotta-600 transition-colors">
          <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <rect x="2" y="2" width="20" height="20" rx="5" ry="5" />
            <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z" />
            <line x1="17.5" y1="6.5" x2="17.51" y2="6.5" />
          </svg>
        </a>

        <a href={socials[1].url} target="_blank" rel="noopener noreferrer" aria-label="LinkedIn" class="text-slate-warm hover:text-terracotta-600 transition-colors">
          <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z" />
            <rect x="2" y="9" width="4" height="12" />
            <circle cx="4" cy="4" r="2" />
          </svg>
        </a>

        <a href={socials[2].url} target="_blank" rel="noopener noreferrer" aria-label="Facebook" class="text-slate-warm hover:text-terracotta-600 transition-colors">
          <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z" />
          </svg>
        </a>

      </div>
    </div>

  </div>
</footer>